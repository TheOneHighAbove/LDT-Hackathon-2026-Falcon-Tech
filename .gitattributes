* text=auto

# Keep cross-platform scripts predictable.
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
LICENSE text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.html text eol=lf

# Binary release artifacts.
*.pt binary
*.npy binary
*.npz binary
*.onnx binary
*.joblib binary
*.ts binary
*.jpg binary
*.jpeg binary
*.png binary

# The deploy checkpoint exceeds GitHub's regular 100 MB object limit. Keep
# this exact-path rule after the generic binary attributes so LFS wins.
weights/best.pt filter=lfs diff=lfs merge=lfs -text
weights/release/*.ts filter=lfs diff=lfs merge=lfs -text
